// Cloudflare deploy config: a static-assets Worker that serves the Vite build.
//   Dashboard: Workers & Pages → Create → Import a repository → pick this repo (it reads this file).
//   Local:     npm run deploy   (runs the build, then `wrangler deploy`; `npx wrangler login` once first)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-vs-agent",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}

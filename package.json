{
  "name": "agent-vs-agent",
  "version": "0.1.0",
  "description": "Agent vs Agent: a bump-and-run spy board game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx scripts/sim.ts",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier -w ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyjmartinez/agent-vs-agent.git"
  },
  "bugs": {
    "url": "https://github.com/tonyjmartinez/agent-vs-agent/issues"
  },
  "homepage": "https://github.com/tonyjmartinez/agent-vs-agent#readme",
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module"
}
